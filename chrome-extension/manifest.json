{
  "manifest_version": 3,
  "name": "ClipIt",
  "version": "1.4.0",
  "description": "Learn languages from YouTube and Netflix videos you love",
  "permissions": ["storage", "scripting", "tabCapture", "offscreen", "activeTab"],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://www.netflix.com/*",
    "https://project-deadbird-backend.onrender.com/*",
    "https://theclipitapp.com/*",
    "https://theclipitapp.vercel.app/*",
    "http://localhost:5176/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.netflix.com/watch/*"],
      "js": ["netflix-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:5176/*", "https://theclipitapp.com/*", "https://theclipitapp.vercel.app/*"],
      "js": ["token-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ClipIt",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["*://*.netflix.com/*"]
    },
    {
      "resources": ["youtube-inject.js"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
